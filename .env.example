# Resend API key used to send order and stock-update emails.
RESEND_API_KEY=<key>

# Recipient and verified sender address for stock-update emails.
STOCK_EMAIL_TO=
STOCK_EMAIL_FROM=onboarding@resend.dev
NEXT_PUBLIC_SUPABASE_URL=<url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<key>

# Service-role (secret) key, used server-only by the cron jobs to bypass RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=<key>

# Shared secret Supabase Cron sends as a Bearer token to /api/cron/*.
CRON_SECRET=<secret>

# Financial Modeling Prep API key, used for the S&P 500 quote on the dashboard and the earnings reminders.
FMP_KEY=<key>